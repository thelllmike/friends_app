# Backend URL. Defaults: iOS simulator / web -> http://127.0.0.1:8000, Android emulator -> http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=
# Google sign-in (Google Cloud console -> OAuth client IDs). The web client ID is also what the backend checks.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Terms and privacy pages
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
